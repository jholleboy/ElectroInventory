diff --git a/Los Santos RED/ElectroInventoryActionProtocol.cs b/Los Santos RED/ElectroInventoryActionProtocol.cs
new file mode 100644
index 0000000000000000000000000000000000000000..fbe3977a403427a26119bc0d952e5453fb836f55
--- /dev/null
+++ b/Los Santos RED/ElectroInventoryActionProtocol.cs	
@@ -0,0 +1,78 @@
+using System;
+using System.IO.MemoryMappedFiles;
+using System.Threading;
+
+namespace ElectroInventory.Wire
+{
+    [Flags]
+    internal enum ActionKind : byte { None = 0, Use = 1, Discard = 2, Deposit = 4, Take = 8, Buy = 16, Sell = 32 }
+    internal enum ActionResult : byte { None, Accepted, Success, Rejected, Expired, Uncertain, Cancelled, Started }
+
+    internal sealed class ActionOffer
+    {
+        public Guid Token;
+        public ActionKind Kinds;
+        public int Maximum;
+    }
+
+    internal sealed class ActionCommand
+    {
+        public Guid Id, Session, Revision, Token;
+        public ActionKind Kind;
+        public int Quantity;
+    }
+
+    // The v1 snapshot remains unchanged. This separate channel binds offers to its exact publication stamp.
+    internal static class ActionProtocol
+    {
+        public const int Magic = 0x45494132, Capacity = 65536, Offers = 160, OfferSize = 24;
+        public static string Channel(int pid) => @"Local\ElectroInventory.Lsr.actions.v2." + pid;
+
+        public static bool Authorize(ActionCommand command, Guid session, Guid revision, ActionOffer offer) =>
+            command != null && command.Id != Guid.Empty && session != Guid.Empty && revision != Guid.Empty
+            && command.Session == session && command.Revision == revision && offer != null
+            && offer.Token != Guid.Empty && command.Token == offer.Token
+            && ValidKind(command.Kind) && (offer.Kinds & command.Kind) != 0
+            && command.Quantity > 0 && command.Quantity <= offer.Maximum
+            && (command.Kind != ActionKind.Use || command.Quantity == 1);
+
+        public static bool ExactTransfer(float from, float to, int quantity)
+        {
+            if (quantity <= 0 || float.IsNaN(from) || float.IsInfinity(from) ||
+                float.IsNaN(to) || float.IsInfinity(to) || to < 0 || from < quantity)
+                return false;
+            // Reject amounts where float arithmetic would lose a fractional residue.
+            return (double)(from - quantity) == (double)from - quantity &&
+                (double)(to + quantity) == (double)to + quantity;
+        }
+
+        public static bool ValidPrice(int unit, int quantity, int balance, bool buy)
+        {
+            if (unit < 0 || quantity <= 0 || balance < 0) return false;
+            long total = (long)unit * quantity;
+            return buy ? total <= balance : total <= int.MaxValue - (long)balance;
+        }
+
+        private static bool ValidKind(ActionKind kind) => kind == ActionKind.Use || kind == ActionKind.Discard
+            || kind == ActionKind.Deposit || kind == ActionKind.Take || kind == ActionKind.Buy || kind == ActionKind.Sell;
+
+        public static Guid ReadGuid(MemoryMappedViewAccessor view, int offset)
+        {
+            var bytes = new byte[16];
+            view.ReadArray(offset, bytes, 0, bytes.Length);
+            return new Guid(bytes);
+        }
+
+        public static void WriteGuid(MemoryMappedViewAccessor view, int offset, Guid guid)
+        {
+            var bytes = guid.ToByteArray();
+            view.WriteArray(offset, bytes, 0, bytes.Length);
+        }
+
+        public static bool TryLock(Mutex mutex)
+        {
+            try { return mutex.WaitOne(0); }
+            catch (AbandonedMutexException) { mutex.ReleaseMutex(); return false; }
+        }
+    }
+}
diff --git a/Los Santos RED/ElectroInventoryActionServer.cs b/Los Santos RED/ElectroInventoryActionServer.cs
new file mode 100644
index 0000000000000000000000000000000000000000..edb0b45bd012f307edecae65c1f655a4e3a68b4c
--- /dev/null
+++ b/Los Santos RED/ElectroInventoryActionServer.cs	
@@ -0,0 +1,150 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO.MemoryMappedFiles;
+using System.Linq;
+using System.Threading;
+using ElectroInventory.Wire;
+
+namespace LosSantosRED.lsr
+{
+    internal sealed class InventoryActionBinding
+    {
+        internal object Identity, Definition;
+        internal ActionOffer Offer;
+        internal Func<ActionCommand, ActionResult> Execute;
+    }
+
+    internal sealed class ElectroInventoryActionServer : IDisposable
+    {
+        private MemoryMappedFile map;
+        private MemoryMappedViewAccessor view;
+        private Mutex mutex;
+        private byte[] previous;
+        private List<InventoryActionBinding> bindings = new List<InventoryActionBinding>();
+        private Guid revision, replyId;
+        private ActionResult reply;
+        private bool disabled, executing;
+
+        internal void Update(int pid, long stamp, Snapshot snapshot, byte[] payload,
+            List<InventoryActionBinding> current)
+        {
+            if (disabled || executing) return;
+            ActionCommand command = null;
+            InventoryActionBinding selected = null;
+            try
+            {
+                if (view == null)
+                {
+                    string channel = ActionProtocol.Channel(pid);
+                    mutex = new Mutex(false, channel + ".Lock");
+                    map = MemoryMappedFile.CreateOrOpen(channel, ActionProtocol.Capacity);
+                    view = map.CreateViewAccessor(0, ActionProtocol.Capacity);
+                }
+                int visibleRows = Protocol.Decode(payload).Rows.Count;
+                if (current.Count > visibleRows) current.RemoveRange(visibleRows, current.Count - visibleRows);
+                bool changed = previous == null || !previous.SequenceEqual(payload) || !SameBindings(current);
+                if (changed) revision = Guid.NewGuid();
+                else
+                    for (int i = 0; i < current.Count; i++)
+                        if (current[i] != null) current[i].Offer.Token = bindings[i].Offer.Token;
+
+                if (!ActionProtocol.TryLock(mutex)) return;
+                try
+                {
+                    if (view.ReadInt32(64) == 1)
+                    {
+                        command = new ActionCommand { Id = ActionProtocol.ReadGuid(view, 68),
+                            Session = ActionProtocol.ReadGuid(view, 84), Revision = ActionProtocol.ReadGuid(view, 100),
+                            Token = ActionProtocol.ReadGuid(view, 116), Kind = (ActionKind)view.ReadByte(132),
+                            Quantity = view.ReadInt32(136) };
+                        view.Write(64, 0);
+                        selected = current.FirstOrDefault(binding => binding?.Offer.Token == command.Token);
+                        bool fresh = Protocol.Fresh(view.ReadInt64(140), Stopwatch.GetTimestamp());
+                        replyId = command.Id;
+                        reply = !fresh || command.Session != snapshot.Session || command.Revision != revision
+                            ? ActionResult.Expired : !ActionProtocol.Authorize(command, snapshot.Session, revision, selected?.Offer)
+                            ? ActionResult.Rejected : ActionResult.Accepted;
+                        if (reply == ActionResult.Accepted)
+                        {
+                            // Retire this revision before calling any native routine, including those that yield.
+                            revision = Guid.NewGuid();
+                            foreach (var binding in current)
+                                if (binding != null) binding.Offer.Token = Guid.NewGuid();
+                        }
+                        else selected = null;
+                    }
+                    view.Write(8, 0L);
+                    view.Write(0, ActionProtocol.Magic);
+                    view.Write(4, pid);
+                    ActionProtocol.WriteGuid(view, 16, revision);
+                    view.Write(32, current.Count);
+                    for (int i = 0; i < current.Count; i++)
+                    {
+                        int offset = ActionProtocol.Offers + i * ActionProtocol.OfferSize;
+                        var offer = current[i]?.Offer;
+                        ActionProtocol.WriteGuid(view, offset, offer?.Token ?? Guid.Empty);
+                        view.Write(offset + 16, (byte)(offer?.Kinds ?? ActionKind.None));
+                        view.Write(offset + 20, offer?.Maximum ?? 0);
+                    }
+                    ActionProtocol.WriteGuid(view, 40, replyId);
+                    view.Write(56, (byte)reply);
+                    if (selected == null) view.Write(8, stamp);
+                    previous = payload;
+                    bindings = current;
+                }
+                finally { mutex.ReleaseMutex(); }
+
+                if (selected != null)
+                {
+                    executing = true;
+                    try { reply = selected.Execute(command); }
+                    catch (ThreadAbortException) { throw; }
+                    catch (Exception e)
+                    {
+                        reply = ActionResult.Uncertain;
+                        Rage.Game.LogTrivial("[ElectroInventory RC2] Executor interrompido: " + e.GetType().Name);
+                    }
+                    finally
+                    {
+                        executing = false;
+                        previous = null;
+                    }
+                }
+            }
+            catch (ThreadAbortException) { throw; }
+            catch (Exception e)
+            {
+                disabled = true;
+                Dispose();
+                Rage.Game.LogTrivial("[ElectroInventory RC2] Canal de ações desativado: " + e.GetType().Name);
+            }
+        }
+
+        private bool SameBindings(List<InventoryActionBinding> other)
+        {
+            if (other.Count != bindings.Count) return false;
+            for (int i = 0; i < other.Count; i++)
+            {
+                var left = bindings[i];
+                var right = other[i];
+                if (left == null && right == null) continue;
+                if (left == null || right == null || !ReferenceEquals(left.Identity, right.Identity)
+                    || !ReferenceEquals(left.Definition, right.Definition)
+                    || left.Offer.Kinds != right.Offer.Kinds || left.Offer.Maximum != right.Offer.Maximum) return false;
+            }
+            return true;
+        }
+
+        public void Dispose()
+        {
+            if (view != null && mutex != null && ActionProtocol.TryLock(mutex))
+            {
+                try { view.Write(8, 0L); view.Write(64, 0); }
+                finally { mutex.ReleaseMutex(); }
+            }
+            view?.Dispose(); map?.Dispose(); mutex?.Dispose();
+            view = null; map = null; mutex = null;
+        }
+    }
+}
diff --git a/Los Santos RED/ElectroInventoryProtocol.cs b/Los Santos RED/ElectroInventoryProtocol.cs
new file mode 100644
index 0000000000000000000000000000000000000000..840981c46fecb61af1c6df5970601517347c6135
--- /dev/null
+++ b/Los Santos RED/ElectroInventoryProtocol.cs	
@@ -0,0 +1,135 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Text;
+
+namespace ElectroInventory.Wire
+{
+    internal sealed class Entry
+    {
+        public string Id, Name, Category, Description, Detail;
+        public double Quantity = double.NaN;
+        public double Price = double.NaN;
+        internal object TradeBinding;
+        public byte Group; // 0 player/items, 1 stored items, 2 weapons, 3 cash, 4 buy, 5 sell
+    }
+
+    internal sealed class Snapshot
+    {
+        public Guid Session;
+        public long PublicationStamp;
+        internal object StorageContext;
+        public int Character;
+        public byte Mode; // 0 inventory, 1 storage, 2 trade
+        public bool BlocksInput, Incomplete;
+        public string Title;
+        public double Balance = double.NaN;
+        public List<Entry> Rows = new List<Entry>();
+    }
+
+    internal static class Protocol
+    {
+        public const int Magic = 0x45494E31, Version = 1, Header = 24, Capacity = 1024 * 1024;
+        public const int MaxRows = 2000, MaxTextBytes = 4096;
+        private static readonly UTF8Encoding Utf8 = new UTF8Encoding(false, true);
+        public static string Channel(int pid) => @"Local\ElectroInventory.Lsr.read.v1." + pid;
+        public static bool Fresh(long stamp, long now) =>
+            stamp > 0 && stamp <= now && now - stamp <= Stopwatch.Frequency * 2;
+
+        public static byte[] Encode(Snapshot value)
+        {
+            using (var rows = new MemoryStream())
+            using (var rowWriter = new BinaryWriter(rows, Utf8, true))
+            using (var output = new MemoryStream())
+            using (var writer = new BinaryWriter(output, Utf8, true))
+            {
+                int count = 0;
+                foreach (var row in value.Rows)
+                {
+                    if (count == MaxRows || rows.Length > Capacity - Header - 6 * MaxTextBytes - 128)
+                        break;
+                    rowWriter.Write(row.Group);
+                    rowWriter.Write(row.Quantity);
+                    rowWriter.Write(row.Price);
+                    WriteText(rowWriter, row.Id);
+                    WriteText(rowWriter, row.Name);
+                    WriteText(rowWriter, row.Category);
+                    WriteText(rowWriter, row.Description);
+                    WriteText(rowWriter, row.Detail);
+                    count++;
+                }
+                writer.Write(value.Session.ToByteArray());
+                writer.Write(value.Character);
+                writer.Write(value.Mode);
+                writer.Write(value.BlocksInput);
+                writer.Write(value.Incomplete || count < value.Rows.Count);
+                writer.Write(value.Balance);
+                WriteText(writer, value.Title);
+                writer.Write(count);
+                rows.WriteTo(output);
+                return output.ToArray();
+            }
+        }
+
+        public static Snapshot Decode(byte[] payload)
+        {
+            if (payload == null || payload.Length > Capacity - Header)
+                throw new InvalidDataException("Tamanho do snapshot inválido.");
+            using (var input = new MemoryStream(payload, false))
+            using (var reader = new BinaryReader(input, Utf8))
+            {
+                var value = new Snapshot
+                {
+                    Session = new Guid(reader.ReadBytes(16)),
+                    Character = reader.ReadInt32(),
+                    Mode = reader.ReadByte(),
+                    BlocksInput = reader.ReadBoolean(),
+                    Incomplete = reader.ReadBoolean(),
+                    Balance = ReadNumber(reader, true),
+                    Title = ReadText(reader)
+                };
+                int count = reader.ReadInt32();
+                if (value.Session == Guid.Empty || value.Character == 0 || value.Mode > 2 || count < 0 || count > MaxRows)
+                    throw new InvalidDataException("Metadados inválidos.");
+                for (int i = 0; i < count; i++)
+                {
+                    byte group = reader.ReadByte();
+                    if (group > 5) throw new InvalidDataException("Grupo inválido.");
+                    value.Rows.Add(new Entry { Group = group, Quantity = ReadNumber(reader, false), Price = ReadNumber(reader, false),
+                        Id = ReadText(reader), Name = ReadText(reader), Category = ReadText(reader),
+                        Description = ReadText(reader), Detail = ReadText(reader) });
+                }
+                if (input.Position != input.Length) throw new InvalidDataException("Dados excedentes.");
+                return value;
+            }
+        }
+
+        private static double ReadNumber(BinaryReader reader, bool signed)
+        {
+            double value = reader.ReadDouble();
+            if (double.IsInfinity(value) || (!signed && value < 0))
+                throw new InvalidDataException("Valor numérico inválido.");
+            return value;
+        }
+
+        private static void WriteText(BinaryWriter writer, string text)
+        {
+            text = text ?? "";
+            int use = Math.Min(text.Length, MaxTextBytes / 4);
+            if (use > 0 && char.IsHighSurrogate(text[use - 1])) use--;
+            byte[] bytes = Encoding.UTF8.GetBytes(text.Substring(0, use));
+            writer.Write(bytes.Length);
+            writer.Write(bytes);
+        }
+
+        private static string ReadText(BinaryReader reader)
+        {
+            int length = reader.ReadInt32();
+            if (length < 0 || length > MaxTextBytes) throw new InvalidDataException("Campo de texto inválido.");
+            byte[] bytes = reader.ReadBytes(length);
+            if (bytes.Length != length) throw new EndOfStreamException();
+            return Utf8.GetString(bytes);
+        }
+    }
+}
diff --git a/Los Santos RED/ElectroInventoryPublisher.cs b/Los Santos RED/ElectroInventoryPublisher.cs
new file mode 100644
index 0000000000000000000000000000000000000000..bbef82676d6820289b248ba41ac962d0c5d7acf3
--- /dev/null
+++ b/Los Santos RED/ElectroInventoryPublisher.cs	
@@ -0,0 +1,281 @@
+using ElectroInventory.Wire;
+using Rage;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO.MemoryMappedFiles;
+using System.Threading;
+
+namespace LosSantosRED.lsr
+{
+    internal sealed class ElectroInventoryPublisher : IDisposable
+    {
+        private static object owner;
+        private static Func<bool> valid;
+        private static Action<Snapshot> fill;
+        private static Guid contextSession;
+        private static long touch;
+        private MemoryMappedFile map;
+        private MemoryMappedViewAccessor view;
+        private Mutex mutex;
+        private Guid personalSession;
+        private int character;
+        private bool disabled;
+        private readonly ElectroInventoryActionServer actions = new ElectroInventoryActionServer();
+        private static bool BlocksPersonal(ModController controller) =>
+            !controller.Player.ActivityManager.CanPerformActivitesBase || controller.IsDisplayingAlertScreen || VehicleShowcase.ElectroInventoryActive
+            || !controller.Player.IsAliveAndFree || controller.Player.CuffManager.IsHandcuffed
+            || controller.Player.IsShowingFrontEndMenus || controller.Player.IsDisplayingCustomMenus
+            || controller.Player.IsShowingActionWheel || controller.Player.CellPhone?.IsActive == true
+            || controller.Player.ActivityManager.IsInteractingWithLocation || controller.Player.ActivityManager.IsPerformingActivity;
+
+        private static bool SupportsUse(ModItem item) => item is FoodItem || item is DrinkItem || item is BodyArmorItem
+            || item is FlashlightItem && !(item is CellphoneItem) || item is BinocularsItem
+            || item is RadioItem || item is UmbrellaItem;
+
+        private static bool SameCharacter(ModController controller, int handle) =>
+            controller.IsRunning && controller.Player?.Character != null && controller.Player.Character.Exists()
+            && unchecked((int)(uint)controller.Player.Character.Handle) == handle;
+
+        private static InventoryActionBinding PersonalBinding(ModController controller, Snapshot snapshot, Entry row)
+        {
+            if (snapshot.Mode != 0 || snapshot.BlocksInput || row.Group != 0)
+                return null;
+            var player = controller.Player;
+            var item = player.Inventory.ItemsList.Find(candidate => candidate.ModItem?.Name == row.Id);
+            if (item == null || item.Amount <= 0 || player.Inventory.ItemsList.FindLast(candidate => candidate.ModItem?.Name == row.Id) != item)
+                return null;
+            var kinds = ActionKind.Discard | (SupportsUse(item.ModItem) ? ActionKind.Use : ActionKind.None);
+            return new InventoryActionBinding
+            {
+                Identity = item, Offer = new ActionOffer { Token = Guid.NewGuid(), Kinds = kinds, Maximum = item.Amount },
+                Execute = command =>
+                {
+                    if (!SameCharacter(controller, snapshot.Character) || BlocksPersonal(controller)
+                        || !ReferenceEquals(player.Inventory.Get(item.ModItem), item) || item.RemainingPercent != row.Quantity)
+                        return ActionResult.Expired;
+                    if (command.Kind == ActionKind.Use && SupportsUse(item.ModItem))
+                        return player.ActivityManager.TryElectroInventoryUse(item.ModItem) ? ActionResult.Started : ActionResult.Rejected;
+                    if (command.Kind != ActionKind.Discard || command.Quantity > item.Amount
+                        || (command.Quantity != 1 && command.Quantity != item.Amount && !(command.Quantity == 5 && item.Amount > 5)))
+                        return ActionResult.Rejected;
+                    return player.ActivityManager.TryElectroInventoryDrop(item.ModItem, command.Quantity,
+                        () => SameCharacter(controller, snapshot.Character) && player.IsAliveAndFree
+                            && ReferenceEquals(player.Inventory.Get(item.ModItem), item)
+                            && item.RemainingPercent == row.Quantity)
+                        ? ActionResult.Started : ActionResult.Rejected;
+                }
+            };
+        }
+
+        internal static void Track(object key, Func<bool> isValid, Action<Snapshot> populate)
+        {
+            if (!ReferenceEquals(owner, key)) contextSession = Guid.NewGuid();
+            owner = key;
+            valid = isValid;
+            fill = populate;
+            touch = Stopwatch.GetTimestamp();
+        }
+
+        internal static void Clear(object key)
+        {
+            if (!ReferenceEquals(owner, key)) return;
+            owner = null;
+            valid = null;
+            fill = null;
+        }
+
+        private sealed class StorageAuthority
+        {
+            public SimpleInventory Items;
+            public List<ItemType> Allowed, Denied;
+
+            public bool Includes(ItemType type) => Allowed != null && Allowed.Count > 0
+                ? Allowed.Contains(type) : Denied == null || !Denied.Contains(type);
+        }
+
+        private static bool ContextStillValid(ModController controller, Snapshot snapshot) =>
+            SameCharacter(controller, snapshot.Character) && controller.Player.IsAliveAndFree &&
+            !controller.IsDisplayingAlertScreen && !controller.Player.CuffManager.IsHandcuffed
+            && owner != null && contextSession == snapshot.Session
+            && Stopwatch.GetTimestamp() - touch <= Stopwatch.Frequency / 2 && valid();
+
+        private static InventoryActionBinding StorageBinding(ModController controller, Snapshot snapshot, Entry row)
+        {
+            if (!(snapshot.StorageContext is StorageAuthority authority) || (row.Group != 0 && row.Group != 1))
+                return null;
+            var player = controller.Player;
+            bool take = row.Group == 1;
+            var source = take ? authority.Items.ItemsList : player.Inventory.ItemsList;
+            var target = take ? player.Inventory.ItemsList : authority.Items.ItemsList;
+            var item = source.Find(candidate => candidate.ModItem?.Name == row.Id);
+            if (item == null || !authority.Includes(item.ModItem.ItemType) || row.Quantity < 1
+                || row.Quantity >= int.MaxValue || source.FindLast(candidate => candidate.ModItem?.Name == row.Id) != item
+                || target.Find(candidate => candidate.ModItem?.Name == row.Id) != target.FindLast(candidate => candidate.ModItem?.Name == row.Id))
+                return null;
+            int maximum = (int)Math.Floor(row.Quantity);
+            return new InventoryActionBinding
+            {
+                Identity = item, Offer = new ActionOffer { Token = Guid.NewGuid(), Kinds = take ? ActionKind.Take : ActionKind.Deposit,
+                    Maximum = maximum },
+                Execute = command =>
+                {
+                    if (!ContextStillValid(controller, snapshot) || source.Find(candidate => candidate.ModItem?.Name == row.Id) != item
+                        || source.FindLast(candidate => candidate.ModItem?.Name == row.Id) != item || item.RemainingPercent != row.Quantity
+                        || !authority.Includes(item.ModItem.ItemType) || command.Quantity > Math.Floor(item.RemainingPercent))
+                        return ActionResult.Expired;
+                    var destination = target.Find(candidate => candidate.ModItem?.Name == row.Id);
+                    if (destination != target.FindLast(candidate => candidate.ModItem?.Name == row.Id)
+                        || controller.ModDataFileManager.ModItems.Get(row.Id) == null
+                        || !ActionProtocol.ExactTransfer(item.RemainingPercent, destination?.RemainingPercent ?? 0, command.Quantity))
+                        return ActionResult.Rejected;
+                    return item.ModItem.TransferElectroInventory(player, authority.Items, command.Quantity, take, false)
+                        ? ActionResult.Success : ActionResult.Rejected;
+                }
+            };
+        }
+
+        private static InventoryActionBinding TradeBinding(ModController controller, Snapshot snapshot, Entry row)
+        {
+            var binding = row.TradeBinding as InventoryActionBinding;
+            if (binding == null) return null;
+            var execute = binding.Execute;
+            binding.Execute = command => ContextStillValid(controller, snapshot) ? execute(command) : ActionResult.Expired;
+            return binding;
+        }
+
+        internal static void Storage(Snapshot snapshot, string title, SimpleInventory items,
+            WeaponStorage weapons, CashStorage cash, List<ItemType> allowed, List<ItemType> denied, bool withAnimations)
+        {
+            snapshot.Mode = 1;
+            if (!withAnimations && items != null)
+                snapshot.StorageContext = new StorageAuthority { Items = items, Allowed = allowed, Denied = denied };
+            snapshot.Title = title;
+            var restrictions = new List<string>();
+            if (items != null) restrictions.Add("Itens");
+            if (weapons != null) restrictions.Add("Armas");
+            if (cash != null) restrictions.Add("Dinheiro");
+            snapshot.Title += " | " + string.Join(", ", restrictions);
+            if (items != null) CopyItems(snapshot, items.ItemsList, 1, allowed, denied);
+            if (weapons != null)
+                foreach (var weapon in weapons.StoredWeapons)
+                {
+                    if (snapshot.Rows.Count >= Protocol.MaxRows) { snapshot.Incomplete = true; break; }
+                    snapshot.Rows.Add(new Entry { Id = weapon.WeaponHash.ToString(), Name = weapon.ElectroInventoryDisplayName,
+                        Category = "Armas", Quantity = 1, Group = 2, Detail = "Munição: " + weapon.Ammo });
+                }
+            if (cash != null && snapshot.Rows.Count < Protocol.MaxRows)
+                snapshot.Rows.Add(new Entry { Id = "cash", Name = "Dinheiro em espécie", Category = "Dinheiro",
+                    Quantity = cash.StoredCash, Group = 3 });
+        }
+
+        private static void CopyItems(Snapshot snapshot, List<InventoryItem> items, byte group,
+            List<ItemType> allowed = null, List<ItemType> denied = null)
+        {
+            foreach (var item in items)
+            {
+                if (snapshot.Rows.Count >= Protocol.MaxRows) { snapshot.Incomplete = true; break; }
+                var definition = item?.ModItem;
+                if (definition == null || item.RemainingPercent <= 0 || float.IsNaN(item.RemainingPercent)
+                    || float.IsInfinity(item.RemainingPercent)
+                    || (allowed != null && allowed.Count > 0 ? !allowed.Contains(definition.ItemType)
+                        : denied != null && denied.Contains(definition.ItemType))) continue;
+                snapshot.Rows.Add(new Entry { Id = definition.Name, Name = definition.DisplayName,
+                    Category = global::LanguageStrings.Translate("content.item.type." + definition.ItemType, definition.ItemType.ToString()),
+                    Description = definition.DisplayDescription, Group = group, Quantity = item.RemainingPercent,
+                    Detail = (definition.IsPossessionIllicit ? "Posse ilícita. " : "") + definition.GetDisplayMeasurementName()
+                        + (definition.CanConsume ? " · Consumível" : "") });
+            }
+        }
+
+        internal void Publish(ModController controller)
+        {
+            if (disabled) return;
+            try
+            {
+                var player = controller.Player;
+                var ped = player?.Character;
+                if (!controller.IsRunning || ped == null || !ped.Exists()) return;
+                int handle = unchecked((int)(uint)ped.Handle);
+                if (character != handle)
+                {
+                    if (character != 0) Clear(owner);
+                    character = handle;
+                    personalSession = Guid.NewGuid();
+                }
+                var snapshot = new Snapshot
+                {
+                    Session = personalSession, Character = character, Title = "Inventário pessoal",
+                    BlocksInput = BlocksPersonal(controller)
+                };
+                if (owner != null && Stopwatch.GetTimestamp() - touch <= Stopwatch.Frequency / 2 && valid())
+                {
+                    snapshot.Session = contextSession;
+                    snapshot.BlocksInput = true;
+                    fill(snapshot);
+                }
+                if (snapshot.Mode != 2 && player.Inventory != null)
+                    CopyItems(snapshot, player.Inventory.ItemsList, 0);
+                byte[] payload = Protocol.Encode(snapshot);
+                int pid;
+                using (var process = Process.GetCurrentProcess()) pid = process.Id;
+                if (view == null)
+                {
+                    string channel = Protocol.Channel(pid);
+                    mutex = new Mutex(false, channel + ".Lock");
+                    map = MemoryMappedFile.CreateOrOpen(channel, Protocol.Capacity);
+                    view = map.CreateViewAccessor(0, Protocol.Capacity);
+                }
+                long stamp = 0;
+                bool held = false;
+                try
+                {
+                    try { held = mutex.WaitOne(0); }
+                    catch (AbandonedMutexException) { held = true; }
+                    if (!held) return;
+                    view.Write(16, 0L);
+                    view.Write(0, Protocol.Magic);
+                    view.Write(4, Protocol.Version);
+                    view.Write(8, pid);
+                    view.Write(12, payload.Length);
+                    view.WriteArray(Protocol.Header, payload, 0, payload.Length);
+                    stamp = Stopwatch.GetTimestamp();
+                    view.Write(16, stamp);
+                }
+                finally { if (held) mutex.ReleaseMutex(); }
+                var bindings = snapshot.Rows.ConvertAll(row => snapshot.Mode == 1
+                    ? StorageBinding(controller, snapshot, row) : snapshot.Mode == 2
+                    ? TradeBinding(controller, snapshot, row) : PersonalBinding(controller, snapshot, row));
+                actions.Update(pid, stamp, snapshot, payload, bindings);
+            }
+            catch (ThreadAbortException) { throw; }
+            catch (Exception e)
+            {
+                disabled = true;
+                Dispose();
+                Game.LogTrivial("[ElectroInventory RC2] publicação interrompida: " + e.GetType().Name);
+            }
+        }
+
+        public void Dispose()
+        {
+            Clear(owner);
+            actions.Dispose();
+            if (view != null)
+            {
+                bool held = false;
+                try
+                {
+                    try { held = mutex.WaitOne(0); }
+                    catch (AbandonedMutexException) { held = true; }
+                    if (held) view.Write(16, 0L);
+                }
+                catch (System.IO.IOException) { }
+                catch (ObjectDisposedException) { }
+                finally { if (held) mutex.ReleaseMutex(); }
+            }
+            view?.Dispose(); map?.Dispose(); mutex?.Dispose();
+            view = null; map = null; mutex = null;
+        }
+    }
+}
diff --git a/Los Santos RED/ElectroInventoryTradeRules.cs b/Los Santos RED/ElectroInventoryTradeRules.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ebf5fc87fccb52faf05fe9f4783b73a8c078098d
--- /dev/null
+++ b/Los Santos RED/ElectroInventoryTradeRules.cs	
@@ -0,0 +1,22 @@
+using System;
+
+namespace ElectroInventory.Wire
+{
+    internal static class TradeRules
+    {
+        public static int BuyLimit(int maximum, int stock, int sold) =>
+            Math.Max(0, stock < 0 ? maximum : (int)Math.Max(0, Math.Min(maximum, (long)stock - sold)));
+
+        public static int SellLimit(float quantity, int demand, int bought)
+        {
+            if (float.IsNaN(quantity) || quantity <= 0 || quantity >= int.MaxValue) return 0;
+            int owned = (int)Math.Floor(quantity);
+            return demand < 0 ? owned : (int)Math.Max(0, Math.Min(owned, (long)demand - bought));
+        }
+
+        public static bool QuoteAllows(bool permitted, int quotedPrice, int currentPrice,
+            int quantity, int maximum, int balance, bool buy) =>
+            permitted && quotedPrice == currentPrice && quantity <= maximum &&
+            ActionProtocol.ValidPrice(currentPrice, quantity, balance, buy);
+    }
+}
